{
  "name": "smart-app-ph",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@smartapp/storefront --filter=@smartapp/dashboard",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:start": "supabase db start",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/api/src/database.types.ts"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "supabase": "2.120.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
